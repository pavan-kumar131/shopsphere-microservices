POSTGRES_DB=ecommerce
POSTGRES_USER=ecommerce_app
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_LOCAL_PASSWORD
# Generate with: openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_BASE64_SECRET_FROM_OPENSSL
ADMIN_EMAIL=admin@shopsphere.local
ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD

# Shared only by trusted internal service calls; generate a separate random value.
INTERNAL_SERVICE_TOKEN=REPLACE_WITH_RANDOM_INTERNAL_TOKEN_AT_LEAST_32_CHARACTERS

# Google Identity Services OAuth 2.0 Web client ID (same value in frontend + backend)
GOOGLE_CLIENT_ID=
